{
  "id": "com.opf.model-library-viewer",
  "name": "Direct Ollama Model Library Explorer",
  "version": "1.1.0",
  "author": "BennyAI2 (OPF Official)",
  "trust_tier": "official",
  "risk_tier": 1,
  "description": "Browse the online Ollama model library directly inside the desktop UI with local GPU VRAM compatibility estimators and 1-click model pull.",
  "min_ollama_version": "0.12.0",
  "max_tested_ollama_version": "0.40.17",
  "verified_ollama_versions": ["0.12.3", "0.40.15", "0.40.16", "0.40.17"],
  "watch_paths": ["api/types.go", "server/routes.go"],
  "isolation_profile": "profile_c_curated_https",
  "permissions": [
    "ui:sidebar",
    "ollama:models:read",
    "ollama:models:pull",
    "net:get:ollama.com"
  ],
  "entry": "index.js"
}
